# Server Port (Render/Heroku/Koyeb injects PORT automatically)
PORT=5000

# Public URL of the backend (used for generating uploaded image URLs)
SERVER_PUBLIC_URL=http://localhost:5000

# Frontend URL (for CORS allowance)
CLIENT_URL=http://localhost:5173

# Optional: MongoDB Connection URI (Leave empty or unset for in-memory persistence)
# Example MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/syncboard?retryWrites=true&w=majority
MONGO_URI=
